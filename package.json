{
  "name": "ipims",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "db:generate": "pnpm --filter @ipims/db prisma:generate",
    "db:migrate": "pnpm --filter @ipims/db prisma:migrate",
    "db:migrate:prod": "pnpm --filter @ipims/db prisma:migrate:prod",
    "db:studio": "pnpm --filter @ipims/db prisma:studio",
    "db:reset": "pnpm --filter @ipims/db prisma:reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.5.3",
    "typescript": "^5.8.2",
    "prettier": "^3.5.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
